# --- kobo-insights API configuration (safe defaults — no secrets) ---

# HTTP port the API listens on
PORT=3001

# Prisma / SQLite database (file-based, created by `prisma migrate dev`)
DATABASE_URL="file:./dev.db"

# --- Optional AI layer (Anthropic Claude) ---
# The app runs fully WITHOUT this: a deterministic rules engine categorizes
# every transaction offline. Set AI_ENABLED=true AND provide a key to (a) let
# Claude categorize the transactions the rules can't confidently place, and
# (b) unlock the "Ask your statement" natural-language Q&A.
AI_ENABLED=false
ANTHROPIC_API_KEY=

# Models (only used when AI is enabled). Cheap/fast model for bulk
# categorization; a stronger model for question answering.
KOBO_CATEGORIZE_MODEL=claude-haiku-4-5
KOBO_ASK_MODEL=claude-sonnet-5

# Safety cap on how many rows a single uploaded statement may contain
MAX_UPLOAD_ROWS=5000
